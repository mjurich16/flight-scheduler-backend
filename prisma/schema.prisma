generator client {
  provider = "prisma-client-js"
}
datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}
model User {
  id           Int      @id @default(autoincrement())
  name         String
  email        String   @unique
  passwordHash String
  role         String
  assignments  Assignment[]
}
model Flight {
  id              Int       @id @default(autoincrement())
  flightNumber    String
  aircraft        String
  includesTanking Boolean   @default(false)
  takeoffTime     DateTime?
  assignments     Assignment[]
}
model Assignment {
  id       Int     @id @default(autoincrement())
  user     User    @relation(fields: [userId], references: [id])
  userId   Int
  flight   Flight  @relation(fields: [flightId], references: [id])
  flightId Int
}
